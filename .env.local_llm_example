# Local LLM Configuration Example
# Copy these settings to your .env file to enable local LLM support

# ==================== LLM PROVIDER SELECTION ====================

# Choose your LLM provider:
# - "litellm" = Remote LLM via LiteLLM (current default)
# - "local_llama" = Local Llama via Ollama
LLM_SDK=local_llama

# ==================== LOCAL LLM SETTINGS ====================

# Enable local LLM support
LOCAL_LLM_ENABLED=true

# Ollama server configuration
LOCAL_LLM_HOST=localhost
LOCAL_LLM_PORT=11434

# Model configuration
LOCAL_LLM_MODEL=llama3.1:8b

# Performance settings
LOCAL_LLM_TIMEOUT=60
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_CONTEXT_LENGTH=8192
LOCAL_LLM_MAX_TOKENS=4096

# ==================== EXISTING SETTINGS ====================
# Keep your existing settings below this line

GEMINI_API_KEY=api_key_here
LOG_LEVEL=INFO

DB_URL=postgresql+asyncpg://<username>:<password>@<hostname>/<database>
DB_SCHEMA=saaransh
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_DEBUG=true

KEYCLOAK_URL="http://localhost:8081"
KEYCLOAK_AUTHORITY=http://localhost:8081/realms/saaransh
KEYCLOAK_RESOURCE_REALM="saaransh"
KEYCLOAK_CLIENT_REALM="nirdesh"
KEYCLOAK_M2M_CLIENT_ID="client_id_here"
KEYCLOAK_M2M_CLIENT_SECRET="client_secret_here"

ENABLE_ASANA=true
ASANA_ACCESS_TOKEN=your_asana_token_here